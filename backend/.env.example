# ===== Servidor =====
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://seu-frontend.vercel.app

# ===== Banco de dados (MySQL - Railway) =====
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ultima_fatia

# ===== Autenticação admin =====
JWT_SECRET=troque-por-um-segredo-forte-de-64-caracteres-aleatorios
JWT_EXPIRES_IN=8h

# ===== Pix (NUNCA usar prefixo NEXT_PUBLIC_ ou PUBLIC_) =====
PIX_KEY=chave-pix-do-proprietario
PIX_MERCHANT_NAME=ULTIMA FATIA
PIX_MERCHANT_CITY=SAO PAULO
PIX_MAX_NAME_LEN=25
