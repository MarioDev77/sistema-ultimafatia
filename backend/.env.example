# ===== Servidor =====
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://seu-frontend.vercel.app

# ===== Banco de dados (MySQL - Railway) =====
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ultima_fatia

# ===== Autenticação admin =====
JWT_SECRET=troque-por-um-segredo-forte-de-64-caracteres-aleatorios
JWT_EXPIRES_IN=8h

# ===== Pix (NUNCA usar prefixo NEXT_PUBLIC_ ou PUBLIC_) =====
PIX_KEY=chave-pix-do-proprietario
PIX_MERCHANT_NAME=ULTIMA FATIA
PIX_MERCHANT_CITY=SAO PAULO
PIX_MAX_NAME_LEN=25

# ===== Assistente de matemática financeira (painel admin) =====
# Opcional: sem essa chave o servidor sobe normalmente, só a aba
# "Assistente IA" do admin fica indisponível (erro 503 tratado).
# NUNCA usar prefixo NEXT_PUBLIC_/PUBLIC_ — essa chave é só de backend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
